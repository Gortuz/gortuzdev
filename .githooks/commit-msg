#!/bin/sh
# Validates the commit message against CONTRIBUTING.md (Conventional Commits, English, ≤72 chars).
msg_file="$1"
title=$(grep -v '^#' "$msg_file" | sed -n '1p')

# Let git's own generated messages through
case "$title" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

types='feat|fix|refactor|perf|style|docs|build|chore|revert'
if ! printf '%s' "$title" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [a-z0-9].*[^.]$"; then
  echo "✗ Commit message does not follow CONTRIBUTING.md:"
  echo "    $title"
  echo ""
  echo "  Expected: <type>(<scope>): <summary in English, imperative, lowercase, no period>"
  echo "  Types:    feat fix refactor perf style docs build chore revert"
  echo "  Example:  feat(hero): replace project metrics with developer strengths"
  exit 1
fi

length=$(printf '%s' "$title" | wc -m | tr -d ' ')
if [ "$length" -gt 72 ]; then
  echo "✗ Commit title is $length characters; keep it at 72 or fewer."
  exit 1
fi

if ! grep -v '^#' "$msg_file" | sed -n '2p' | grep -Eq '^$|^\s*$' && [ "$(grep -v '^#' "$msg_file" | wc -l | tr -d ' ')" -gt 1 ]; then
  echo "✗ Leave a blank line between the title and the body."
  exit 1
fi
