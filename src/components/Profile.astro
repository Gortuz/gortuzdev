---
// Profile.astro - Bio, education and recognition, and the stack as plain columns
import TechIcon from './TechIcon.astro';
import type { Content } from '../data/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="perfil" class="profile" aria-labelledby="profile-heading">
  <div class="wrap">
    <div class="grid top">
      <h2 id="profile-heading">{t.profile.heading}</h2>
      <div class="bio">
        {t.profile.bio.map((para) => <p>{para}</p>)}
        <p class="languages">{t.profile.languages}</p>
      </div>
    </div>

    <div class="grid record-block">
      <h3 class="block-title">{t.profile.recordHeading}</h3>
      <ul class="record">
        {t.profile.record.map((entry) => (
          <li>
            <span class="r-title">{entry.title}</span>
            <span class="r-detail">{entry.detail}</span>
            <span class="r-date num">{entry.date}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid stack-block">
      <h3 class="block-title">{t.profile.stackHeading}</h3>
      <div class="stack">
        {t.profile.stack.map((group) => (
          <div class="group">
            <h4>{group.group}</h4>
            <ul>
              {group.items.map((item) => <li><TechIcon name={item} /><span>{item}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .profile {
    background: var(--ground-alt);
    padding-block: calc(var(--m) * 12) calc(var(--m) * 16);
    border-top: 2px solid var(--rule);
  }

  .top {
    margin-bottom: calc(var(--m) * 12);
  }

  h2 {
    grid-column: 1 / span 5;
    font-size: clamp(56px, 7vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variation-settings: "wdth" 125;
  }

  .bio {
    grid-column: 7 / span 6;
    padding-top: calc(var(--m) * 1.5);
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink);
  }

  .bio p + p {
    margin-top: calc(var(--m) * 2);
  }

  .bio .languages {
    margin-top: calc(var(--m) * 4);
    padding-top: calc(var(--m) * 2);
    border-top: 1px solid var(--rule-quiet);
    font-size: 15px;
    color: var(--ink-muted);
  }

  .block-title {
    grid-column: 1 / span 3;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    padding-top: calc(var(--m) * 2);
  }

  .record-block {
    margin-bottom: calc(var(--m) * 12);
  }

  .record {
    grid-column: 4 / span 9;
    list-style: none;
    border-top: 2px solid var(--rule);
  }

  .record li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 1.4fr);
    gap: calc(var(--m) * 3);
    padding-block: calc(var(--m) * 2);
    border-bottom: 1px solid var(--rule-quiet);
    font-size: 16px;
    line-height: 1.4;
  }

  .r-title {
    color: var(--ink);
    font-weight: 600;
  }

  .r-detail {
    color: var(--ink-soft);
  }

  .r-date {
    color: var(--ink-muted);
    text-align: right;
  }

  .stack {
    grid-column: 4 / span 9;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .group {
    position: relative;
    border-top: 2px solid var(--rule);
    padding-top: calc(var(--m) * 2);
  }

  /* Hover, by line: a lime rule draws across, the same live state as the nav and work entries */
  .record li,
  .group {
    position: relative;
  }

  .record li::after,
  .group::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--live-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease-out);
    pointer-events: none;
  }

  .record li::after { bottom: -1px; }
  .group::before { top: -2px; }

  .r-title,
  .group li {
    transition: color 240ms var(--ease-out), translate 240ms var(--ease-out);
  }

  .group li :global(.tech-icon) {
    transition: color 240ms var(--ease-out);
  }

  @media (hover: hover) {
    .record li:hover::after,
    .group:hover::before {
      transform: scaleX(1);
    }

    .record li:hover .r-title {
      color: var(--action);
    }

    .group li:hover {
      color: var(--ink);
      translate: 4px 0;
    }

    .group li:hover :global(.tech-icon) {
      color: var(--action);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .record li::after,
    .group::before,
    .r-title,
    .group li,
    .group li :global(.tech-icon) {
      transition: none;
    }
  }

  h4 {
    color: var(--ink);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    min-height: 2.6em;
  }

  .group ul {
    list-style: none;
    margin-top: calc(var(--m) * 1.5);
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .group li {
    display: flex;
    align-items: flex-start;
    gap: calc(var(--m) * 1.25);
    padding-block: 5px;
  }

  .group li :global(.tech-icon) {
    margin-top: 1px;
  }

  @media (max-width: 1180px) {
    .stack { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: calc(var(--m) * 5); }
  }

  @media (max-width: 1080px) {
    h2 { grid-column: 1 / -1; }
    .bio { grid-column: 1 / span 10; padding-top: calc(var(--m) * 4); }
    .block-title { grid-column: 1 / -1; padding-bottom: calc(var(--m) * 2); }
    .record, .stack { grid-column: 1 / -1; }
  }

  @media (max-width: 760px) {
    .profile { padding-block: calc(var(--m) * 8) calc(var(--m) * 10); }
    .top, .record-block { margin-bottom: calc(var(--m) * 8); }
    .bio { grid-column: 1 / -1; font-size: 17px; }
    .record li { grid-template-columns: 1fr; gap: 2px; }
    .r-date { text-align: left; }
    /* Phone: one group per row, its items run inline instead of a tall column */
    .stack { grid-template-columns: 1fr; row-gap: calc(var(--m) * 3); }
    h4 { min-height: 0; }
    /* Icons now separate the items, so they run inline without slashes */
    .group ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: calc(var(--m) * 2.5);
      margin-top: var(--m);
    }
  }
</style>
