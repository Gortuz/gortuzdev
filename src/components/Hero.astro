---
// Hero.astro - First viewport: the poster. Name, role, three shipped facts, the email action.
import Diamond from './Diamond.astro';
import Arrow from './Arrow.astro';
import { EMAIL, type Content } from '../data/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="plane" aria-hidden="true">
    <Diamond assemble />
  </div>

  <div class="wrap grid content">
    <h1 id="hero-name">Alan<br />Sandoval</h1>
    <p class="role">{t.hero.role}</p>
    <p class="status"><span class="dot" aria-hidden="true"></span>{t.hero.status}</p>

    <ul class="facts">
      {t.hero.facts.map((fact) => (
        <li>
          <span class="value">{fact.value}</span>
          <span class="label">{fact.label}</span>
        </li>
      ))}
    </ul>

    <a class="action" href={`mailto:${EMAIL}`}>
      <span class="email">{EMAIL.split('@')[0]}@<wbr />{EMAIL.split('@')[1]}</span>
      <span class="go">{t.hero.write} <Arrow /></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--m) * 9);
    display: flex;
    align-items: center;
    padding-block: calc(var(--m) * 10) calc(var(--m) * 8);
    overflow: hidden;
  }

  /* The diamond at poster scale, cropped by the right edge */
  .plane {
    position: absolute;
    top: 50%;
    right: max(-18vw, -300px);
    width: min(62vw, 1000px);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .content {
    position: relative;
    row-gap: 0;
  }

  h1 {
    grid-column: 1 / span 6;
    font-size: clamp(64px, 9.4vw, 136px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    font-variation-settings: "wdth" 100;
  }

  .role {
    grid-column: 1 / span 6;
    margin-top: calc(var(--m) * 4);
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.3;
    color: var(--ink);
    font-weight: 400;
  }

  /* Live state in lime: a square, not a dot, to stay in the straight-line grammar */
  .status {
    grid-column: 1 / span 6;
    display: flex;
    align-items: center;
    gap: calc(var(--m) * 1.5);
    margin-top: calc(var(--m) * 3);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .dot {
    width: var(--m);
    height: var(--m);
    flex-shrink: 0;
    background: var(--live);
    outline: 1px solid var(--live-ink);
    outline-offset: 2px;
  }

  .facts {
    grid-column: 1 / span 6;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    list-style: none;
    margin-top: calc(var(--m) * 6);
  }

  .facts li {
    border-top: 2px solid var(--rule);
    padding-top: calc(var(--m) * 2);
  }

  .value {
    display: block;
    color: var(--action);
    font-size: clamp(22px, 1.75vw, 26px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-variation-settings: "wdth" 75;
    text-wrap: balance;
  }

  .label {
    display: block;
    margin-top: calc(var(--m) * 1.5);
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .action {
    grid-column: 1 / span 6;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: calc(var(--m) * 2);
    margin-top: calc(var(--m) * 5);
    padding-top: calc(var(--m) * 2);
    border-top: 3px solid var(--action);
    color: var(--ink);
    font-size: clamp(17px, 1.6vw, 22px);
    font-weight: 700;
    text-decoration: none;
    position: relative;
  }

  .email {
    overflow-wrap: break-word;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: var(--m);
    color: var(--action);
    font-weight: 800;
    white-space: nowrap;
  }

  .go :global(.arrow) {
    transition: translate 320ms var(--ease-out);
  }

  .action:hover .go :global(.arrow),
  .action:focus-visible .go :global(.arrow) {
    translate: 6px 0;
  }

  .action:hover .email {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Short laptop screens: tighten the rhythm so the email stays in the first screen */
  @media (min-width: 761px) and (max-height: 820px) {
    .hero { padding-block: calc(var(--m) * 6) calc(var(--m) * 5); }
    h1 { font-size: clamp(64px, min(9.4vw, 15vh), 136px); }
    .role { margin-top: calc(var(--m) * 3); }
    .status { margin-top: calc(var(--m) * 2); }
    .facts { margin-top: calc(var(--m) * 5); }
    .action { margin-top: calc(var(--m) * 4); }
  }

  /* Tablet and phone: the whole logo sits behind the text as a quiet watermark */
  @media (max-width: 1080px) {
    .hero {
      display: block;
      min-height: 0;
      padding-top: calc(var(--m) * 8);
    }
    .plane {
      top: calc(var(--m) * 2);
      right: calc(var(--m) * -2);
      width: min(72vw, 640px);
      transform: none;
      opacity: var(--mark-opacity);
      z-index: 0;
    }
    .content { z-index: 1; }
    h1, .facts, .action { grid-column: 1 / span 10; }
    .role, .status { grid-column: 1 / span 8; }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: calc(var(--m) * 6);
      padding-bottom: calc(var(--m) * 7);
    }
    .plane {
      top: var(--m);
      right: -18vw;
      width: 104vw;
    }
    h1 {
      font-size: min(15.5vw, 64px);
    }
    .value {
      font-size: 28px;
    }
    h1, .role, .status, .facts, .action { grid-column: 1 / -1; }
    .action {
      order: 3;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--m);
      margin-top: calc(var(--m) * 4);
    }
    .facts {
      order: 4;
      grid-template-columns: 1fr;
      gap: calc(var(--m) * 3);
      margin-top: calc(var(--m) * 6);
    }
  }
</style>
